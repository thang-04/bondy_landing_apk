# Copy thành .env rồi điền giá trị thật. .env đã được gitignore.

# Backend API mà /api-proxy, /uploads rewrite tới (không có dấu / cuối).
# Bỏ trống sẽ dùng mặc định https://103.149.86.25/api (VPS production).
API_PROXY_TARGET=https://103.149.86.25/api

# Token bảo vệ endpoint /api/logs (phải khớp LOGS_API_TOKEN cấu hình trên VPS)
LOGS_API_TOKEN=

# Google Analytics (chỉ bật ở production)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_DOMAINS=
